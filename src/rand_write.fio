; Varian 6 — penulisan acak O_DIRECT untuk pengukuran write amplification.
; Jalankan dari run_all.sh, misalnya:
;   fio rand_write.fio --directory="$MNT" --output="$LOG" --output-format=normal
;
; `size` membatasi file kerja menjadi 16 MiB, sedangkan `io_size`
; memastikan aplikasi menerbitkan total 50 MiB I/O logis.

[global]
ioengine=sync
direct=1
rw=randwrite
bs=4k
size=16m
io_size=50m
numjobs=1
time_based=0
end_fsync=1
group_reporting=1

[rand_write_direct_4k]
filename=fio-rand-write.dat
